# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API (para generar emails con IA)
# IMPORTANTE: La key se usa solo server-side (Vercel functions).
# En producción, configurar en Vercel Dashboard → Settings → Environment Variables.
# Nunca commitear la key real a git.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# App Config
VITE_APP_NAME=Digpatho CRM

# -----------------------------------------------
# AI Growth System (Python backend — ai_growth_system.py)
# -----------------------------------------------
# Service role key bypasses RLS — required for backend scripts.
# Get it from Supabase Dashboard → Settings → API → service_role key.
# If not set, the system falls back to VITE_SUPABASE_ANON_KEY.
SUPABASE_SERVICE_KEY=your-service-role-key

# -----------------------------------------------
# Vertex AI (Gemini) — búsqueda de emails con Google Search grounding
# -----------------------------------------------
# JSON de Workload Identity Federation (WIF) para autenticarse con GCP
# sin guardar service-account keys. Se configura en Vercel Dashboard →
# Settings → Environment Variables → OIDC tab.
# El OIDC token de Vercel se federa automáticamente con GCP.
GCP_WIF_CONFIG={"type":"external_account","audience":"//iam.googleapis.com/...","token_url":"https://sts.googleapis.com/v1/token",...}

# Región de Vertex AI (default: us-central1)
# VERTEX_AI_REGION=us-central1

# -----------------------------------------------
# Google Chat — avisos al espacio del equipo
# -----------------------------------------------
# Incoming webhook del espacio: en Chat, nombre del espacio → Apps e
# integraciones → Agregar webhooks. La URL ES la credencial: cualquiera que la
# tenga puede postear. Va sin prefijo VITE_ para que no viaje en el bundle.
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# Espacio de prueba. Si está seteada, TIENE PRIORIDAD sobre la de arriba —
# útil en Preview para no ensuciar el espacio real.
# GCHAT_WEBHOOK_URL_TEST=

# Kill switch. En 'false' el endpoint responde 200 sin postear nada.
# GCHAT_NOTIFY_ENABLED=true

# En 'true' arma la tarjeta y la loguea sin llamar a Google Chat.
# GCHAT_DRY_RUN=false

# URL base para los botones "Ver en el CRM" de las tarjetas.
# Si no se setea, se deriva de VERCEL_URL.
# APP_BASE_URL=https://crm-digpatho.vercel.app
